# Per-deployment (Mexico / Colombia) config — never shared between countries, never committed as .env.

VITE_COUNTRY=CO
VITE_KIOSK_ID=

# Evius — separate event per country, separate experienceId per experience (Memory Match vs Catalogo)
VITE_EVIUS_URL=
VITE_EVIUS_TOKEN=
VITE_EVIUS_EVENT_ID=
VITE_EVIUS_EXPERIENCE_ID=

# Nombre de esta experiencia tal como debe aparecer como "source" en Evius.
VITE_EXPERIENCE_NAME="Mirage - Memory Match"

# Shared Supabase project ("Mirage Colombia" — the name is just a label, it holds
# both countries and both experiences). Table: participations, unique on
# (participant_id, country, experience). Views ranking_by_experience /
# ranking_combined read from it (combined averages catalogo + memory_match per
# person, treating whichever wasn't played as 0) — nothing here needs to write those.
# RANKING_DB_URL = bare Project URL, no /rest/v1 or table name (the code appends both).
# RANKING_DB_API_KEY = the project's Secret key (service_role), NOT the Publishable/anon
# key — participations has no insert policy for anon/authenticated, so the anon key
# fails (401/403) rather than being silently rejected.
VITE_RANKING_DB_URL=
VITE_RANKING_DB_API_KEY=
VITE_RANKING_DB_TABLE=participations
