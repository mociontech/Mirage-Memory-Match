# Copy to .env.local and fill in per país/kiosco. Never commit .env.local.

# Identifica el tótem físico que envió una participación.
VITE_KIOSK_ID=

# País de este despliegue, ISO 3166-1 alpha-2 (CO / MX). Nunca hardcodear,
# nunca compartir el mismo valor entre despliegues.
VITE_COUNTRY=

# Nombre de esta experiencia tal como debe aparecer como "source" en Evius.
VITE_EXPERIENCE_NAME="Mirage - Memory Match"

# Evius — evento separado por país ("Mirage Colombia" / "Mirage Mexico"),
# experienceId propio de Memory Match (distinto al de Catálogo).
VITE_EVIUS_URL=
VITE_EVIUS_TOKEN=
VITE_EVIUS_EVENT_ID=
VITE_EVIUS_EXPERIENCE_ID=

# Shared Supabase project ("Mirage Colombia" — el nombre es solo una etiqueta,
# ahí escriben ambos países y ambas experiencias). Tabla: participations,
# único en (participant_id, country, experience). Columna participant_name
# (texto, nullable) agregada para mostrar el nombre real en el ranking en vez
# del email — ver migración en el chat de implementación. Vistas de lectura
# ranking_by_experience / ranking_combined (esta última promedia catálogo +
# memory_match por persona, tratando la no jugada como 0) deben exponer
# participant_name también.
# RANKING_DB_URL = Project URL pelada, sin /rest/v1 ni nombre de tabla.
# RANKING_DB_API_KEY = la Secret key del proyecto (service_role), NO la
# Publishable/anon key — participations no tiene policy de insert para
# anon/authenticated, así que la anon key falla (401/403) en vez de escribir.
VITE_RANKING_DB_URL=
VITE_RANKING_DB_API_KEY=
VITE_RANKING_DB_TABLE=participations
