# Copy to .env.local and fill in per kiosk / environment. Never commit .env.local.

# Identifies which physical totem sent a participation.
VITE_KIOSK_ID=

# Write-only company Data Hub endpoint. Left empty, submitParticipation()
# throws and the outbox just keeps retrying — safe default until this exists.
VITE_DATA_HUB_URL=

# Supabase/Firebase (or whatever gets picked) — used for used-ID lookups
# and the Top 10 ranking. Same empty-safe behavior as above.
VITE_RANKING_DB_URL=
